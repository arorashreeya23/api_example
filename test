
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'SC Prosper Sans', Arial, sans-serif;
            background: #f5f5f5;
        }
        .positive { color: #228B22; }
        .negative { color: #B22222; }
    </style>
</head>
<body>
    <div style="padding-left: 100px; padding-right: 100px;">
        <!-- Header -->
        <div style="width: 100%; padding-left: 20px; padding-right: 20px; padding-top: 18px; padding-bottom: 18px; background: #020B43; justify-content: space-between; align-items: center; display: flex">
            <div style="width: 110px; height: 43px; position: relative; overflow: hidden">
                <img style="width: 130px; height: 69px; left: -13px; top: -13px; position: absolute" src="{{ scb_logo }}" />
            </div>
            <div style="color: white; font-size: 12px; font-weight: 500;">
                {{current_date}}
            </div>
        </div>

        <!-- Content Area -->
        <div style="background: white; padding: 40px;">
            <!-- Daily Update Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 4px; height: 50px; background: #0066CC;"></div>
                    <h1 style="font-size: 36px; font-weight: 300; color: #000;">Daily Update</h1>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <img style="width: 30px; height: 30px;" src="{{ cap_logo }}" />
                    <span style="font-size: 14px; color: #333;">Commercial Analytics Platform</span>
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid #ddd; margin-bottom: 30px;">

            <!-- Greeting -->
            <h2 style="color: #0066CC; font-size: 24px; font-weight: 600; margin-bottom: 20px;">{{ name }}</h2>
            
            <!-- Description Text -->
            <div style="display: flex; align-items: center; gap: 40px; margin-bottom: 30px;">
                <div style="flex: 1; line-height: 1.6;">
                    <p style="color: #333; font-size: 14px;">
                        Your CAPFM analytics have been refreshed with the latest data.<br>
                        A snapshot of key metrics has been provided below to keep you up to date. CAPFM uses FM OneSales for coverage entitlements. If you have questions on your data below, please speak to the <a href="#" style="color: #0066CC;">FM COOs</a> to check your coverage entitlements.
                    </p>
                </div>

                <div style="width: 1px; height: 80px; background: #ddd;"></div>

                <div style="text-align: right;">
                    <div style="color: #333; font-weight: 600; margin-bottom: 5px;">For full details</div>
                    <a href="#" style="color: #0066CC; font-size: 16px; font-weight: 600; text-decoration: none;">Access CAP FM Now</a>
                </div>
            </div>

            <!-- FVC Glance Section -->
            <div style="margin-top: 30px;">
                <!-- Blue Header -->
                <div style="background: #0066CC; padding: 15px; text-align: center;">
                    <h3 style="color: white; font-size: 18px; font-weight: 600;">Your FVC at a glance on {{ prev_day }} (USD)</h3>
                </div>

                <!-- Metrics Container -->
                <div style="background: #f8f8f8; padding: 30px 20px; display: flex; align-items: center; justify-content: space-around;">
                    <!-- Date Column -->
                    <div style="text-align: center;">
                        <div style="color: #666; font-size: 13px; font-weight: 600; margin-bottom: 10px;">{{ prev_day }}</div>
                        <div style="color: #333; font-size: 28px; font-weight: 600;">{{ prev_day_FVC }}</div>
                    </div>

                    <div style="width: 1px; height: 70px; background: #ccc;"></div>

                    <!-- MTD Column -->
                    <div style="text-align: center;">
                        <div style="color: #666; font-size: 13px; font-weight: 600; margin-bottom: 10px;">MTD</div>
                        <div style="color: #333; font-size: 28px; font-weight: 600;">{{ mtd_FVC }}</div>
                    </div>

                    <div style="width: 1px; height: 70px; background: #ccc;"></div>

                    <!-- MTD MoM% Column -->
                    <div style="text-align: center;">
                        <div style="color: #666; font-size: 13px; font-weight: 600; margin-bottom: 10px;">MTD MoM%</div>
                        <div class="{% if mtd_mom_pct_FVC > 0 %}positive{% else %}negative{% endif %}" style="font-size: 28px; font-weight: 600;">{% if mtd_mom_pct_FVC > 0 %}▲{% else %}▼{% endif %}{{ mtd_mom_pct_FVC }}</div>
                    </div>

                    <div style="width: 1px; height: 70px; background: #ccc;"></div>

                    <!-- YTD Column -->
                    <div style="text-align: center;">
                        <div style="color: #666; font-size: 13px; font-weight: 600; margin-bottom: 10px;">YTD</div>
                        <div style="color: #333; font-size: 28px; font-weight: 600;">{{ ytd_FVC }}</div>
                    </div>

                    <div style="width: 1px; height: 70px; background: #ccc;"></div>

                    <!-- YTD YoY% Column -->
                    <div style="text-align: center;">
                        <div style="color: #666; font-size: 13px; font-weight: 600; margin-bottom: 10px;">YTD YoY%</div>
                        <div class="{% if ytd_yoy_pct_FVC > 0 %}positive{% else %}negative{% endif %}" style="font-size: 28px; font-weight: 600;">{% if ytd_yoy_pct_FVC > 0 %}▲{% else %}▼{% endif %}{{ ytd_yoy_pct_FVC }}</div>
                    </div>
                </div>

                <!-- Source Footer -->
                <div style="background: #f8f8f8; padding: 15px 20px;">
                    <p style="color: #666; font-size: 12px; text-align: center;">
                        Source: CIB Data Analytics Store as of {{ prev_day }}. This data originates from Product Control on a T-2 day basis.
                    </p>
                </div>
            </div>

            <!-- Product Table Section -->
            <div style="margin-top: 30px;">
                <!-- Green Header -->
                <div style="width: 100%; padding-left: 233px; padding-right: 233px; padding-top: 4px; padding-bottom: 4px; background: #38D200; justify-content: center; align-items: center; gap: 10px; display: inline-flex;">
                    <div style="justify-content: center; display: flex; flex-direction: column; color: white; font-size: 12px; font-family: SC Prosper Sans; font-weight: 700; line-height: 16px; word-wrap: break-word;">
                        Your YTD FVC & CI by Product on {{prev_day}} (USD)
                    </div>
                </div>

                <!-- Product Table -->
                <div style="margin-top: 0;">
                    {{producttable}}
                </div>

                <!-- client Table Section -->
            <div style="margin-top: 30px;">
                <!-- Grey Header -->
                <div style="width: 100%; padding-left: 233px; padding-right: 233px; padding-top: 4px; padding-bottom: 4px; background: #525355; justify-content: center; align-items: center; gap: 10px; display: inline-flex;">
                    <div style="justify-content: center; display: flex; flex-direction: column; color: white; font-size: 12px; font-family: SC Prosper Sans; font-weight: 700; line-height: 16px; word-wrap: break-word;">
                        Your Daily Revenue by Client on {{prev_day}} (USD)
                    </div>
                </div>

                <!-- Product Table -->
                <div style="margin-top: 0;">
                    {{clientTable}}
                </div>
            </div>
            </div>
        </div>

        <!-- Confidential Footer -->
        <div style="width: 100%; background: #1B2A5E; padding: 30px 40px; margin-top: 0;">
            <p style="color: white; font-size: 13px; text-align: center; line-height: 1.6; margin: 0;">
                The information in this email is to be treated as confidential and for the intended employee only. Please do not forward this email.
            </p>
        </div>
    </div>
</body>
</html>
